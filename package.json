{
  "name": "secondbarnone",
  "version": "2.3.0",
  "description": "A narrative balance game \u2014 L\u00e9on, a spiritual community, a bar, and a city full of people.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint docs/js/",
    "format": "prettier --write docs/js/ docs/css/ docs/index.html",
    "format:check": "prettier --check docs/js/ docs/css/ docs/index.html",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"scripts/**\" --test-reporter=spec \"tests/**/*.test.js\"",
    "coverage:check": "node scripts/coverage-gate.js",
    "serve": "node scripts/serve.js",
    "assets": "./scripts/optimize-assets.sh",
    "check": "npm test && node scripts/check-assets.js",
    "typecheck": "tsc --project tsconfig.json",
    "test:fast": "node --test tests/balance.test.js tests/cast.test.js tests/coverage.test.js tests/exploits.test.js tests/game.test.js tests/invariants.test.js tests/new-features.test.js tests/presentation.test.js tests/progression.test.js tests/slots.test.js tests/systems.test.js tests/world.test.js",
    "test:ui": "node --test tests/dom.test.js tests/ui.test.js tests/accessibility.test.js tests/portrait-popup.test.js",
    "test:assets": "node --test tests/portrait-assets.test.js"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
