{
  "name": "secondbarnone",
  "version": "2.6.0",
  "description": "A narrative balance game — Léon, a spiritual community, a bar, and a city full of people.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint docs/js/",
    "format": "prettier --write docs/js/ docs/css/ docs/index.html",
    "format:check": "prettier --check docs/js/ docs/css/ docs/index.html",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"scripts/**\" --test-reporter=spec \"tests/**/*.test.js\"",
    "coverage:check": "node scripts/coverage-gate.js",
    "serve": "node scripts/serve.js",
    "assets": "./scripts/optimize-assets.sh",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && node scripts/check-assets.js",
    "typecheck": "tsc --project jsconfig.json",
    "simulate": "node scripts/simulate.js"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
